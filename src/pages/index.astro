---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import ServiceCard from '../components/ServiceCard.astro';
import FAQ from '../components/FAQ.astro';
import ContactSection from '../components/sections/ContactSection.astro';
import TransformationConsole from '../components/sections/TransformationConsole.astro';
import WorkSteps from '../components/sections/WorkSteps.astro';
import copy from '../content/inicio.json';
import site from '../content/sitio.json';
const [services, work, about] = await Promise.all([
  getCollection('servicios'), getEntry('paginas', 'como-trabajamos'), getEntry('paginas', 'quienes-somos'),
]);
const order = ['03', '01', '02'];
services.sort((a, b) => order.indexOf(a.data.step) - order.indexOf(b.data.step));
---
<BaseLayout title={copy.title} description={copy.description}>
  <section class="hero brand-hero grid-surface">
    <div class="shell hero-grid">
      <div>
        <p class="eyebrow"><span aria-hidden="true"></span>{copy.etiqueta}</p>
        <h1>{copy.hero} <em>{copy.heroAcento}</em></h1>
        <p class="lead">{copy.subtitulo}</p>
        <div class="actions">
          <Button href="#diagnostico" arrow>{copy.cta}</Button>
          <Button href="/test-madurez" variant="outline">Haz el test de madurez</Button>
        </div>
      </div>
      <TransformationConsole />
    </div>
    <div class="shell tech-strip">
      <p>// tecnologías con las que trabajamos</p>
      <ul>{copy.tecnologias.map(tech => <li>{tech}</li>)}</ul>
    </div>
  </section>

  <section class="white-section figures-band" aria-label="Experiencia en cifras">
    <ul class="shell figures-grid">
      {copy.cifras.map(([value, label, count]) => <li><strong>
        {typeof count === 'number' ? <><span class="sr-only">{value}</span><span aria-hidden="true" data-count={count} data-prefix={String(value).startsWith('+') ? '+' : ''}>{value}</span></> : value}
      </strong><span>{label}</span></li>)}
    </ul>
  </section>

  <section class="section" id="servicios">
    <div class="shell" data-reveal>
      <p class="section-tag">// servicios</p>
      <h2>{copy.serviciosTitulo}</h2>
      <p class="lead">{copy.serviciosIntro}</p>
      <div class="bento">
        {services.map(service => <ServiceCard service={service} />)}
        <article class="bento-test">
          <div><h3>¿Qué tan preparada está tu empresa para la nube y la IA?</h3><p>Responde 10 preguntas y recibe tres recomendaciones para avanzar.</p></div>
          <Button href="/test-madurez" arrow>Empezar el test</Button>
        </article>
      </div>
    </div>
  </section>

  <section class="section white-section" id="sectores">
    <div class="shell" data-reveal>
      <p class="section-tag">// experiencia</p>
      <h2>Rigor de banca y telecomunicaciones, a la medida de una pyme</h2>
      <div class="grid-four">
        {copy.sectores.map(([title, text]) => <article class="sector-card"><h3>{title}</h3><p>{text}</p></article>)}
      </div>
    </div>
  </section>

  {work && <section class="section"><div class="shell" data-reveal>
    <h2>{work.data.hero}</h2><p class="lead">{work.data.intro}</p>
    <WorkSteps steps={work.data.steps ?? []} />
    <Button variant="text" href="/como-trabajamos" arrow>Conoce cómo trabajamos</Button>
  </div></section>}

  {about && <section class="section white-section"><div class="shell about-grid" data-reveal>
    {site.fotoEquipo
      ? <img class="team-photo" src={site.fotoEquipo} alt="Equipo de ingeniería de Nexo Impulso" width="480" height="400" loading="lazy" />
      : <img class="team-photo" src="/crecimiento-cloud-ia-480.webp" srcset="/crecimiento-cloud-ia-480.webp 480w, /crecimiento-cloud-ia-960.webp 960w" sizes="(max-width: 760px) 91vw, 480px" alt="Tres plataformas ascendentes conectadas a una nube con una red de inteligencia artificial" width="480" height="400" loading="lazy" decoding="async" />}
    <div>
      <p class="section-tag">// quiénes somos</p>
      <h2>Ingenieros que impulsan tu negocio</h2>
      <p class="lead">{about.data.intro}</p>
      <ul class="tags"><li>AWS Certified Solutions Architect</li><li>Microsoft Azure</li><li>Google Cloud (GCP)</li><li>Kubernetes (EKS)</li></ul>
      <div class="mission home-mission"><h3>nuestra_misión</h3><p>{about.data.mision}</p></div>
      <Button variant="text" href="/quienes-somos" arrow>Conoce al equipo</Button>
    </div>
  </div></section>}

  <section class="section"><div class="shell faq-grid" data-reveal><h2>{copy.faqTitulo}</h2><FAQ items={copy.faq} /></div></section>
  <ContactSection />
</BaseLayout>
<script>
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(entries => {
      for (const { target, isIntersecting } of entries) {
        if (!isIntersecting) continue;
        observer.unobserve(target);
        target.classList.add('revealed');
        if (!(target instanceof HTMLElement) || !target.dataset.count) continue;
        const total = Number(target.dataset.count);
        const start = performance.now();
        const update = (now: number) => {
          const progress = Math.min((now - start) / 650, 1);
          target.textContent = (target.dataset.prefix ?? '') + Math.round(progress * total);
          if (progress < 1) requestAnimationFrame(update);
        };
        requestAnimationFrame(update);
      }
    }, { threshold: 0.1 });
    document.querySelectorAll('[data-reveal], [data-count]').forEach(item => observer.observe(item));
  }
</script>
