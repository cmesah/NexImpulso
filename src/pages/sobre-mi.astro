---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Portrait from '../components/Portrait.astro';
import Button from '../components/Button.astro';
import site from '../content/sitio.json';
const entry = (await getEntry('paginas', 'sobre-mi'))!;
const { Content } = await render(entry);
const { data } = entry;
---
<BaseLayout title={data.title} description={data.description}>
  <section class="section"><div class="shell about-grid">
    <Portrait />
    <div><h1>{data.hero}</h1><p class="lead">{data.intro}</p><div class="prose"><Content /></div><div class="actions"><Button href="/contacto" arrow>Habla conmigo</Button>{site.linkedin && <Button href={site.linkedin} variant="outline">LinkedIn</Button>}</div></div>
  </div></section>
</BaseLayout>
