---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import copy from '../content/contacto.json';
---
<BaseLayout title={copy.success + ' | Nexo Impulso'} description={copy.successText} noindex>
  <section class="page-hero"><div class="shell"><h1>{copy.success}</h1><p class="lead">{copy.successText}</p><Button href="/" variant="outline">Volver al inicio</Button></div></section>
</BaseLayout>
