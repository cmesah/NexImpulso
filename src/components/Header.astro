---
import site from '../content/sitio.json';
import Button from './Button.astro';
import Icon from './Icon.astro';
---
<header class="site-header">
  <div class="shell nav-row">
    <a class="brand" href="/">
      <img src="/nexo-icono.png" alt="Nexo Impulso, consultoría TI" width="40" height="40" />
      <span aria-hidden="true"><strong>{site.nombre}</strong><small>Consultoría TI</small></span>
    </a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="principal">
      <Icon name="menu" /><span class="sr-only">Menú principal</span>
    </button>
    <nav id="principal" class="site-nav" aria-label="Principal">
      {site.menu.map(([label, href]) => <a href={href} aria-current={Astro.url.pathname === href ? 'page' : undefined}>{label}</a>)}
      <Button href="/contacto">Diagnóstico gratuito</Button>
    </nav>
  </div>
</header>
<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  const toggle = header?.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = header?.querySelector('nav');
  if (header && toggle && nav) {
    header.dataset.enhanced = '';
    const setOpen = (open: boolean) => toggle.setAttribute('aria-expanded', String(open));
    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') === 'false'));
    nav.addEventListener('click', event => {
      if (event.target instanceof Element && event.target.closest('a') && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });
    header.addEventListener('keydown', event => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });
    matchMedia('(min-width: 900px)').addEventListener('change', () => setOpen(false));
  }
</script>
