---
import { Image } from 'astro:assets';
import site from '../content/sitio.json';
import home from '../content/inicio.json';
const { hero = false } = Astro.props;
const portraits = import.meta.glob<{default: ImageMetadata}>('../assets/images/retrato.{webp,avif,jpg,png}', { eager: true });
const portrait = Object.values(portraits)[0]?.default;
---
<div class:list={['portrait', { 'portrait-hero': hero }]}>
  {portrait ? (
    <Image src={portrait} alt={'Retrato profesional de ' + site.nombre} width={900} format="webp"
      widths={[360, 540, 720, 900]} sizes="(max-width: 760px) 100vw, 450px" loading={hero ? 'eager' : 'lazy'} fetchpriority={hero ? 'high' : 'auto'} />
  ) : (
    <div class="portrait-monogram" aria-hidden="true"><span>C<span>·</span></span><svg width="445" height="445" viewBox="0 0 445 445" fill="none"><circle cx="222.5" cy="222.5" r="190" /><circle cx="222.5" cy="222.5" r="154" /><circle cx="222.5" cy="222.5" r="116" /><path d="M0 222.5h445M222.5 0v445"/></svg></div>
  )}
  {hero && <div class="availability"><span></span>{home.disponibilidad}</div>}
</div>
